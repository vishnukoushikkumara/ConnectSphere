<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConnectSphere | Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0b0f19;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-image: radial-gradient(circle at top right, rgba(0, 85, 255, 0.15) 0%, transparent 40%),
                              radial-gradient(circle at bottom left, rgba(0, 162, 255, 0.1) 0%, transparent 40%);
        }

        .main-card {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.2);
            border-radius: 16px;
            padding: 40px;
            width: 90%;
            max-width: 480px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
            text-align: center;
        }

        .brand-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .brand-connect { color: #38bdf8; }
        .brand-sphere { color: #ffffff; }

        .subtitle {
            font-size: 1.1rem;
            color: #94a3b8;
            margin-bottom: 35px;
            font-weight: 400;
        }

        .btn-new-meeting {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 14px;
            font-size: 1.1rem;
            font-weight: 600;
            width: 100%;
            margin-bottom: 30px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
        }

        .btn-new-meeting:hover {
            background: linear-gradient(135deg, #0369a1, #075985);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(2, 132, 199, 0.5);
            color: #fff;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #475569;
            margin-bottom: 30px;
        }
        
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(71, 85, 105, 0.5);
        }
        
        .divider:not(:empty)::before { margin-right: 15px; }
        .divider:not(:empty)::after { margin-left: 15px; }

        .join-group {
            position: relative;
            margin-bottom: 15px;
        }

        .join-group i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .form-control-custom {
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(56, 189, 248, 0.2);
            border-radius: 8px;
            padding: 12px 12px 12px 45px;
            color: #f8fafc;
            width: 100%;
            font-size: 1rem;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
        }

        .form-control-custom::placeholder {
            color: #64748b;
        }

        .btn-join {
            background: transparent;
            color: #38bdf8;
            border: 1px solid #38bdf8;
            border-radius: 8px;
            padding: 12px;
            font-size: 1rem;
            font-weight: 600;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-join:hover {
            background: rgba(56, 189, 248, 0.1);
            color: #38bdf8;
        }

        .security-text {
            margin-top: 25px;
            font-size: 0.85rem;
            color: #64748b;
        }
        
        .security-text i { margin-right: 5px; }
    </style>
    <script>
        function join() {
            ElementInterval = setInterval(function () {
                const x = document.getElementById("link").value;
                if(x) {
                    window.location.href = x;
                }
                clearInterval(ElementInterval);
            }, 0);
            return false;
        }
    </script>
</head>

<body>
    <div class="main-card">
        <div class="brand-title"><span class="brand-connect">Connect</span><span class="brand-sphere">Sphere</span></div>
        <div class="subtitle">Connect. Collaborate. Communicate.</div>
        
        <form action="/room">
            <button class="btn-new-meeting"><i class="fas fa-video me-2"></i> New Meeting</button>
        </form>

        <div class="divider">or join existing</div>

        <form onsubmit="return join()">
            <div class="join-group">
                <i class="fas fa-link"></i>
                <input type="text" id="link" class="form-control-custom" placeholder="Enter meeting link">
            </div>
            <button type="submit" class="btn-join"><i class="fas fa-sign-in-alt me-2"></i> Join Meeting</button>
        </form>

        <div class="security-text">
            <i class="fas fa-shield-alt"></i> Secure and reliable peer-to-peer connection
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
